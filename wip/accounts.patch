@@ -0,0 +1,92 @@
+"""Акаунти: свій профіль і пароль; головний акаунт — створює інші й скидає їм паролі."""
+from __future__ import annotations
+
+from datetime import datetime
+
+from fastapi import APIRouter, HTTPException, Request, Response
+from pydantic import BaseModel, Field
+
+from app.modules.surplus import accounts
+from app.modules.surplus.models import Account
+from app.shared.auth import COOKIE, MAX_AGE, AdminPrincipal, OwnerPrincipal, account_token
+from app.shared.database import SessionDep
+from app.shared.i18n import L
+
+router = APIRouter(prefix="/api/v1/accounts", tags=["accounts"])
+
+
+class AccountOut(BaseModel):
+    id: int
+    login: str
+    name: str
+    is_owner: bool
+    has_password: bool
+    created_at: datetime | None
+
+    @classmethod
+    def of(cls, a: Account) -> AccountOut:
+        return cls(id=a.id, login=a.login, name=a.name, is_owner=a.is_owner, has_password=bool(a.password_hash),
+                   created_at=a.created_at)
+
+
+class AccountCreate(BaseModel):
+    login: str = Field(min_length=2, max_length=40)
+    name: str = Field(default="", max_length=120)
+    password: str = Field(min_length=6, max_length=200)
+
+
+class AccountUpdate(BaseModel):
+    name: str | None = Field(default=None, max_length=120)
+    password: str | None = Field(default=None, min_length=6, max_length=200)
+
+
+class MeUpdate(BaseModel):
+    name: str | None = Field(default=None, max_length=120)
+    old_password: str = ""
+    new_password: str | None = Field(default=None, min_length=6, max_length=200)
+
+
+@router.get("/me", response_model=AccountOut)
+async def me(session: SessionDep, who: AdminPrincipal):
+    return AccountOut.of(await session.get(Account, who.account_id))
+
+
+@router.put("/me", response_model=AccountOut)
+async def update_me(data: MeUpdate, session: SessionDep, who: AdminPrincipal, response: Response, request: Request):
+    acc = await session.get(Account, who.account_id)
+    if data.name is not None and data.name.strip():
+        acc.name = data.name.strip()
+    if data.new_password:
+        if acc.password_hash and not accounts.check_password(acc, data.old_password):
+            raise HTTPException(422, L("Поточний пароль невірний", "Текущий пароль неверный"))
+        accounts.set_password(acc, data.new_password)
+    await session.commit()
+    await session.refresh(acc)
+    if data.new_password:  # нова сесія, бо підпис старої включав старий пароль
+        response.set_cookie(COOKIE, account_token(acc), max_age=MAX_AGE, httponly=True, samesite="lax",
+                            secure=request.headers.get("x-forwarded-proto", request.url.scheme) == "https")
+    return AccountOut.of(acc)
+
+
+@router.get("", response_model=list[AccountOut])
+async def list_all(session: SessionDep, _: OwnerPrincipal):
+    return [AccountOut.of(a) for a in await accounts.list_accounts(session)]
+
+
+@router.post("", response_model=AccountOut, status_code=201)
+async def create(data: AccountCreate, session: SessionDep, _: OwnerPrincipal):
+    return AccountOut.of(await accounts.create_account(session, data.login, data.name, data.password))
+
+
+@router.put("/{account_id}", response_model=AccountOut)
+async def update(account_id: int, data: AccountUpdate, session: SessionDep, _: OwnerPrincipal):
+    acc = await session.get(Account, account_id)
+    if acc is None:
+        raise HTTPException(404, L("Акаунт не знайдено", "Аккаунт не найден"))
+    if data.name is not None and data.name.strip():
+        acc.name = data.name.strip()
+    if data.password:
+        accounts.set_password(acc, data.password)
+    await session.commit()
+    await session.refresh(acc)
+    return AccountOut.of(acc)
