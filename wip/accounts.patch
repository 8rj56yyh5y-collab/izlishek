+"""Поточний акаунт запиту.
+
+AuthMiddleware ставить його після перевірки сесії; сервіс бере звідси і фільтрує КОЖЕН
+запит до даних (пункти, матеріали, звірки, погашення, налаштування). Якщо акаунт не
+виставлено — помилка, а не «усі дані»: витік між акаунтами гірший за 500.
+"""
+from __future__ import annotations
+
+from contextlib import contextmanager
+from contextvars import ContextVar
+
+_account: ContextVar[int | None] = ContextVar("account_id", default=None)
+
+
+def account_id() -> int:
+    v = _account.get()
+    if v is None:
+        raise RuntimeError("Акаунт запиту не визначено")
+    return v
+
+
+def set_account(v: int | None):
+    return _account.set(v)
+
+
+def reset_account(token) -> None:
+    _account.reset(token)
+
+
+@contextmanager
+def use_account(v: int):
+    token = _account.set(v)
+    try:
+        yield
+    finally:
+        _account.reset(token)
