@@ -0,0 +1,100 @@
+"""Акаунти: створення, паролі, первинне налаштування бази.
+
+Кожен акаунт повністю відокремлений. Перший — головний (is_owner): створює інші акаунти
+й скидає їм паролі, але їхніх даних не бачить (дані фільтруються за account_id всюди).
+"""
+from __future__ import annotations
+
+import hashlib
+import re
+import secrets
+
+from fastapi import HTTPException
+from sqlalchemy import func, inspect, select, text
+from sqlalchemy.ext.asyncio import AsyncSession
+
+from app.modules.surplus.models import Account
+from app.modules.surplus.seed import seed_account
+from app.shared.i18n import L
+
+LOGIN_RE = re.compile(r"^[a-z0-9._-]{2,40}$")
+DATA_TABLES = ("surplus_points", "surplus_materials", "surplus_shipments", "surplus_settlements")
+
+
+def hash_password(password: str, salt: str) -> str:
+    return hashlib.pbkdf2_hmac("sha256", password.encode(), bytes.fromhex(salt), 200_000).hex()
+
+
+def set_password(acc: Account, password: str | None) -> None:
+    if password:
+        acc.password_salt = secrets.token_hex(16)
+        acc.password_hash = hash_password(password, acc.password_salt)
+    else:
+        acc.password_salt = acc.password_hash = None
+
+
+def check_password(acc: Account, password: str) -> bool:
+    if not acc.password_hash:
+        return password == ""
+    return secrets.compare_digest(hash_password(password, acc.password_salt or ""), acc.password_hash)
+
+
+def norm_login(login: str) -> str:
+    return login.strip().lower()
+
+
+async def by_login(db: AsyncSession, login: str) -> Account | None:
+    return await db.scalar(select(Account).where(func.lower(Account.login) == norm_login(login)))
+
+
+async def owner(db: AsyncSession) -> Account | None:
+    return await db.scalar(select(Account).where(Account.is_owner.is_(True)).order_by(Account.id))
+
+
+async def list_accounts(db: AsyncSession) -> list[Account]:
+    return list((await db.scalars(select(Account).order_by(Account.id))).all())
+
+
+async def create_account(db: AsyncSession, login: str, name: str, password: str, *, is_owner: bool = False,
+                         demo: bool = False) -> Account:
+    login = norm_login(login)
+    if not LOGIN_RE.match(login):
+        raise HTTPException(422, L("Логін: 2–40 символів, латиниця, цифри, крапка, дефіс",
+                                   "Логин: 2–40 символов, латиница, цифры, точка, дефис"))
+    if await by_login(db, login):
+        raise HTTPException(422, L("Такий логін уже є", "Такой логин уже есть"))
+    acc = Account(login=login, name=name.strip() or login, is_owner=is_owner)
+    set_password(acc, password)
+    db.add(acc)
+    await db.commit()
+    await db.refresh(acc)
+    await seed_account(db, acc.id, demo=demo)
+    return acc
+
+
+async def bootstrap(db: AsyncSession, app_password: str | None, demo: bool) -> None:
+    """Перший запуск або оновлення зі старої (одноакаунтної) бази.
+
+    * немає акаунтів → головний «admin» з паролем APP_PASSWORD;
+    * дані без account_id (старі записи) → належать головному;
+    * старі налаштування (таблиця surplus_settings) → у налаштування головного.
+    """
+    main = await owner(db)
+    if main is None:
+        main = Account(login="admin", name="Основний", is_owner=True)
+        set_password(main, app_password)
+        db.add(main)
+        await db.commit()
+        await db.refresh(main)
+    for table in DATA_TABLES:
+        await db.execute(text(f"UPDATE {table} SET account_id = :a WHERE account_id IS NULL"), {"a": main.id})
+    conn = await db.connection()
+    has_old = await conn.run_sync(lambda c: inspect(c).has_table("surplus_settings"))
+    if has_old:
+        await db.execute(text(
+            "INSERT INTO surplus_account_settings (account_id, key, value) "
+            "SELECT :a, s.key, s.value FROM surplus_settings s "
+            "WHERE NOT EXISTS (SELECT 1 FROM surplus_account_settings x WHERE x.account_id = :a AND x.key = s.key)"),
+            {"a": main.id})
+    await db.commit()
+    await seed_account(db, main.id, demo=demo)
diff --git a/app/modules/surplus/accounts_router.py b/app/modules/surplus/accounts_router.py
